# ============ 数据：打死不进仓库 ============
data/
*.db
*.enc
*.sqlite
*.db-journal

# ============ 真实成绩：绝不在仓库出现 ============
*.xls
*.xlsx
# 例外：仅允许测试假数据
!tests/fixtures/fake_*.xlsx

# ============ 密钥与真实配置 ============
config/activation.json
config/rules.json
config/ai_settings.json
config/email.json
.env
*.key
*.pem
*.p12

# ============ 打包产物 ============
build/
dist/
__pycache__/
*.pyc
*.spec
*.exe

# ============ 测试与工具缓存 ============
.pytest_cache/
pytest-cache-files-*/
tests/_tmp_exports/
.mypy_cache/
.ruff_cache/

# ============ 日志 ============
logs/
*.log

# ============ 编辑器与系统 ============
.vscode/
.idea/
.DS_Store
Thumbs.db

# 打包自检 / 启动自检的产物（build_exe.ps1 会落在仓库根）
transcript-lens-selfcheck.txt
transcript-lens-bootcheck.txt
transcript-lens-bootcheck.png
release/

# 单文件 exe 的解包目录（--runtime-tmpdir "." 会在 exe 旁边建一个 _MEIxxxxxx）
_MEI*/

# ============ 开发日志：绝不入库 ============
# DSH 会话导出（用户放过来的 zip / 解出来的 jsonl），只用于开发上下文，
# 不是项目产物。推送前必须确认它们没有被 git add。
开发日志/
开发日志*.zip
开发日志*.7z
开发日志*.jsonl
session.v4.jsonl
subagents/

# 本地临时探针目录（selfcheck / pytest 用）
.tl_tmp/
